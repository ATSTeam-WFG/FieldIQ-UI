# Backend API. Defaults to http://localhost:8000 when unset.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Error monitoring — Sentry. Leave blank to disable: every Sentry.init() is
# gated on this, and next.config.js only wraps withSentryConfig when it is set.
NEXT_PUBLIC_SENTRY_DSN=

# Tags Sentry events. NODE_ENV is 'production' for every deployed build, so
# without this alpha and prod are indistinguishable. Use: development | alpha | production
NEXT_PUBLIC_ENVIRONMENT=development

# Playwright fixtures. @example.com is RFC 2606 reserved — never registrable.
TEST_EMAIL=ci-test@example.com
TEST_PASSWORD=
